{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:seed": "tsx e2e/seed.ts",
    "verify": "npm run typecheck && npm run lint && npm run deadcode && npm run test && npm run build && npm run perf:budget",
    "deadcode": "knip --include files,dependencies,exports,types",
    "deadcode:all": "knip",
    "perf:budget": "node scripts/check-performance-budgets.mjs",
    "perf:budget:init": "node scripts/check-performance-budgets.mjs --init"
  },
  "dependencies": {
